              "raw": "{\n  \"CardGuid\": \"<string>\",\n  \"Booking Detail\": {\n    \"ArrivalDate\": \"<date>\",\n    \"PaymentInstruction\": \"<string>\",\n    \"ReferenceNumber\": \"<string>\",\n    \"Traveler\": {\n      \"FirstName\": \"<string>\",\n      \"LastName\": \"<string>\"\n    },\n    \"Company\": {\n      \"Name\": \"<string>\",\n      \"Address1\": \"<string>\",\n      \"Address2\": \"<string>\",\n      \"City\": \"<string>\",\n      \"State\": \"<string>\",\n      \"Zipcode\": \"<string>\",\n      \"Country\": \"<string>\"\n    },\n    \"Contact\": {\n      \"EmailAddress\": \"<string>\",\n      \"PhoneNumber\": \"<string>\",\n      \"InvoiceEmailAddress\": \"<string>\"\n    },\n    \"Property\": {\n      \"GDSCode\": \"<string>\",\n      \"Address1\": \"<string>\",\n      \"Address2\": \"<string>\",\n      \"City\": \"<string>\",\n      \"State\": \"<string>\",\n      \"Zipcode\": \"<string>\",\n      \"Country\": \"<string>\"\n    }\n  }\n}",
