                "name": "MerchantGuid",
                "value": "",
                "type": "path",
                "description": "Merchant's Guid assigned by ConnexPay"
              }
            ]
          },
          "docs": "Use this endpoint to pull details regarding your Available Funds like cash balance, Available to Authorize (ATA) or Available to Issue (ATI), and the details that make up the final number."
