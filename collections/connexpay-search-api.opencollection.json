              },
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "PageNumber",
                "value": "",
                "type": "path",
                "description": "Number of page of the results. Default is 1."
              },
              {
                "name": "PageSize",
                "value": "",
                "type": "path",
                "description": "Size of each page of the results. Default is 1000."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
