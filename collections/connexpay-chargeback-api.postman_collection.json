          "id": "7dac544c-b86d-41f5-a08d-f0496c42d4e5",
          "name": "Create Chargeback",
          "request": {
            "name": "Create Chargeback",
            "description": {
              "content": "Use this endpoint to create a virtual card chargeback. \n\nWhat is behind this API?\n- When a user calls this API, we will create a new case/dispute to Marqeta\n- When case/dispute creation success, the API will transmit the case for Marqeta review\n- When the review passes, the API will transmit the case to the Card Network for Chargeback",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "chargeback"
              ],
              "host": [
