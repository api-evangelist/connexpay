{
  "item": [
    {
      "id": "fb360a48-c862-4e69-ac37-3cfd992ae275",
      "name": "Checkout Sessions",
      "description": {
        "content": "Operations for creating and managing checkout sessions.\n\nCheckout sessions are secure server-side objects that contain all payment details\nfor a transaction. They serve as a bridge between your backend and the ConnexPay SDK,\nensuring that sensitive transaction data cannot be tampered with on the client side.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "011b0a10-b9db-44ea-89e5-5bd4a50e16f8",
          "name": "Create Checkout Session",
          "request": {
            "name": "Create Checkout Session",
            "description": {
              "content": "Creates a new secure checkout session for payment processing.\n\nThe session contains all payment details for a transaction and expires after 60 minutes for security.\nReturns a checkout session ID that can be used with the ConnexPay SDK for frontend payment processing.\n\n## Key Features\n- Secure session management with 60-minute expiration\n- Support for multiple tender types (Credit, ACH, GooglePay, ApplePay)\n- Comprehensive customer and transaction data support\n- Device authorization validation\n- Risk analysis and fraud prevention integration\n\n## Usage Flow\n1. Create checkout session on your backend\n2. Pass the returned `checkoutSessionId` to your frontend\n3. Use the session ID with ConnexPay SDK to render payment form\n4. Process payments through the SDK using the session\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "Checkout",
                "checkout-session"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ClientId\": \"<string>\",\n  \"TenderTypeOptions\": \"<string>\",\n  \"Sale\": {\n    \"DeviceGuid\": \"<uuid>\",\n    \"Amount\": \"<decimal>\",\n    \"TenderType\": \"<string>\",\n    \"Currency\": \"USD\",\n    \"OrderNumber\": \"<string>\",\n    \"OrderDate\": \"<dateTime>\",\n    \"InvoiceNumber\": \"<string>\",\n    \"CustomerID\": \"<string>\",\n    \"BusinessName\": \"<string>\",\n    \"CustomerLabel\": \"<string>\",\n    \"TipAmount\": \"<decimal>\",\n    \"ServiceFee\": \"<decimal>\",\n    \"Discount\": \"<decimal>\",\n    \"GrossAmount\": \"<decimal>\",\n    \"EffectiveAmount\": \"<decimal>\",\n    \"Surcharge\": \"<decimal>\",\n    \"SurchargeLabel\": \"<string>\",\n    \"SurchargeType\": \"<string>\",\n    \"CardDataSource\": \"<string>\",\n    \"RequestIp\": \"<ipv4>\",\n    \"StatementDescription\": \"<string>\",\n    \"Customer\": {\n      \"FirstName\": \"<string>\",\n      \"LastName\": \"<string>\",\n      \"Email\": \"<email>\",\n      \"Phone\": \"<string>\",\n      \"BusinessName\": \"<string>\",\n      \"DateOfBirth\": \"<date>\",\n      \"Address1\": \"<string>\",\n      \"Address2\": \"<string>\",\n      \"City\": \"<string>\",\n      \"State\": \"<string>\",\n      \"Zip\": \"<string>\",\n      \"Country\": \"<string>\",\n      \"SSN4\": \"<string>\",\n      \"DriverLicenseNumber\": \"<string>\",\n      \"DriverLicenseState\": \"<string>\",\n      \"customerId\": \"<string>\"\n    },\n    \"IncludeRiskAnalysis\": \"<boolean>\",\n    \"RiskProcessingOnly\": \"<boolean>\",\n    \"CheckRiskScore\": \"<boolean>\",\n    \"EnhancedData\": {\n      \"CustomerCode\": \"<string>\",\n      \"SalesTax\": \"<decimal>\",\n      \"FreightAmount\": \"<decimal>\",\n      \"DutyAmount\": \"<decimal>\",\n      \"DestinationPostalCode\": \"<string>\",\n      \"DestinationCountryCode\": \"<string>\",\n      \"ShipFromPostalCode\": \"<string>\",\n      \"DiscountAmount\": \"<decimal>\",\n      \"LineItems\": [\n        {\n          \"Description\": \"<string>\",\n          \"UnitCost\": \"<decimal>\",\n          \"Quantity\": \"<decimal>\",\n          \"TotalAmount\": \"<decimal>\",\n          \"ProductCode\": \"<string>\",\n          \"CommodityCode\": \"<string>\",\n          \"UnitOfMeasure\": \"<string>\",\n          \"TaxAmount\": \"<decimal>\",\n          \"DiscountAmount\": \"<decimal>\"\n        },\n        {\n          \"Description\": \"<string>\",\n          \"UnitCost\": \"<decimal>\",\n          \"Quantity\": \"<decimal>\",\n          \"TotalAmount\": \"<decimal>\",\n          \"ProductCode\": \"<string>\",\n          \"CommodityCode\": \"<string>\",\n          \"UnitOfMeasure\": \"<string>\",\n          \"TaxAmount\": \"<decimal>\",\n          \"DiscountAmount\": \"<decimal>\"\n        }\n      ]\n    },\n    \"CustomData\": \"<string>\",\n    \"SendReceipt\": \"<boolean>\",\n    \"CardholderEmail\": \"<email>\",\n    \"AssociateCustomerCard\": \"<boolean>\",\n    \"ActivationDate\": \"<dateTime>\",\n    \"PurchaseActivationDate\": \"<dateTime>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
